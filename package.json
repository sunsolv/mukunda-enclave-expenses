{
  "name": "mukunda-enclave-expenses",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --no-watch",
    "test:import": "node --test scripts/excel-import.test.mjs",
    "test:all": "npm run test && npm run test:import",
    "configure:production": "node scripts/configure-production.mjs",
    "import:excel": "node scripts/import-excel.mjs",
    "provision:accounts": "node scripts/provision-accounts.mjs",
    "production:inspect": "node scripts/inspect-supabase-production.mjs",
    "security:verify": "node scripts/verify-supabase-security.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@supabase/supabase-js": "^2.110.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
